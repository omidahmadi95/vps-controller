# Copy to deploy/.env and fill in. Never commit the real .env.
DB_PASSWORD=change-me

# Optional: Telegram alerts. Leave empty to only log alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dead-man heartbeat URL, pinged after each successful check cycle (at most once per minute).
HEARTBEAT_URL=

# External network the app joins to reach docker-socket-proxy by name.
PROXY_NETWORK=docker-socket-proxy_default

# Image tag of the controller build.
APP_IMAGE=vps-controller:latest
